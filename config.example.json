{
  // Kaynak: VB-Cable "CABLE Input" Windows varsayilan cihazi ise loopback ile oradan yakalanir.
  "source": { "deviceId": "{0.0.0.00000000}.{00000000-0000-0000-0000-000000000001}", "mode": "loopback" },

  // Yalnizca kaynak 2 kanalliysa: FC, LFE ve arka/yan kanallar uretilir.
  "upmix": true,

  "outputs": [
    { "deviceId": "{0.0.0.00000000}.{00000000-0000-0000-0000-000000000002}", "latencyMs": 0, "bufferMs": 40 },
    { "deviceId": "{0.0.0.00000000}.{00000000-0000-0000-0000-000000000003}", "latencyMs": 0, "bufferMs": 40 }
  ],

  // deviceChannel 1 tabanlidir. source: mantiksal kanal -> kazanc (FL, FR, FC, LFE, BL, BR, SL, SR).
  "speakers": [
    { "name": "On Sol",   "outputDeviceId": "{0.0.0.00000000}.{00000000-0000-0000-0000-000000000002}", "deviceChannel": 1, "source": { "FL": 1.0 } },
    { "name": "On Sag",   "outputDeviceId": "{0.0.0.00000000}.{00000000-0000-0000-0000-000000000002}", "deviceChannel": 2, "source": { "FR": 1.0 } },
    { "name": "Arka Sol", "outputDeviceId": "{0.0.0.00000000}.{00000000-0000-0000-0000-000000000003}", "deviceChannel": 1, "source": { "BL": 1.0, "SL": 0.5 }, "delayMs": 0, "gainDb": -2 },
    { "name": "Arka Sag", "outputDeviceId": "{0.0.0.00000000}.{00000000-0000-0000-0000-000000000003}", "deviceChannel": 2, "source": { "BR": 1.0, "SR": 0.5 }, "delayMs": 0, "gainDb": -2 }
  ]
}
