<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); all windows are WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Surround</AssemblyName>
    <RootNamespace>Surround.Desktop</RootNamespace>
    <ApplicationIcon>Assets\surround.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.5.0</Version>
    <Product>Surround</Product>
    <Company>Surround</Company>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Startup: the DSP loops must not run as slow tier-0 code (that starved the sinks and caused an underrun in the first second). -->
    <TieredPGO>false</TieredPGO>
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Surround.Engine\Surround.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF projeleri System.IO'yu örtük using olarak almaz. -->
    <Using Include="System.IO" />
    <!-- WinForms is referenced only for NotifyIcon; its implicit namespaces would clash with WPF's (Application, MessageBox ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\surround.ico" />
  </ItemGroup>

  <!--
    Derlenmiş arayüz (ui/dist) çıktıdaki ui\ klasörüne kopyalanır. Bu proje npm çalıştırmaz;
    önce `npm run build` (ui klasöründe) gerekir (build.ps1 bunu yapar). dist yoksa uygulama bunu açılışta bildirir.
  -->
  <ItemGroup>
    <Content Include="..\..\ui\dist\**\*" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
